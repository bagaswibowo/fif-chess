# TypeSafe API key from https://console.typesafe.ai
# Required to play against Jev. Never commit a real key.
TYPESAFE_API_KEY=

# Password gate. The password itself is never stored.
# SITE_PASSWORD_HMAC is hex HMAC-SHA256 of the password, keyed by SITE_HMAC_KEY.
# Generate both with:
# node -e 'const {createHmac,randomBytes}=require("crypto"); const key=randomBytes(32).toString("hex"); const mac=createHmac("sha256", key).update(process.argv[1]).digest("hex"); console.log("SITE_HMAC_KEY="+key); console.log("SITE_PASSWORD_HMAC="+mac);' 'your-password'
SITE_HMAC_KEY=
SITE_PASSWORD_HMAC=

# Password akun admin (Pak Bagas, username: bagaswibowo).
# WAJIB >= 8 karakter, tanpa nilai bawaan. Dipakai sekali saat seeding users.json.
ADMIN_PASSWORD=

# Cloudflare tunnel
TUNNEL_TOKEN=
